{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Masar: Company and School Bus Portal",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/start-local-portal.mjs", "company", "5177"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "masar-company-portal",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:\\s+http://127\\.0\\.0\\.1:5177/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": false
      },
      "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 }
    },
    {
      "label": "Masar: Super Admin Portal",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/start-local-portal.mjs", "super-admin", "5178"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "masar-super-admin-portal",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:\\s+http://127\\.0\\.0\\.1:5178/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "showReuseMessage": false
      },
      "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 }
    }
  ]
}
