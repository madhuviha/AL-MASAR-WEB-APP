{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install backend dependencies",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Install Company portal dependencies",
      "type": "shell",
      "command": "npm ci",
      "options": { "cwd": "${workspaceFolder}/company-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Install Super Admin dependencies",
      "type": "shell",
      "command": "npm ci",
      "options": { "cwd": "${workspaceFolder}/super-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Install all dependencies",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Install backend dependencies",
        "Install Company portal dependencies",
        "Install Super Admin dependencies"
      ],
      "problemMatcher": []
    },
    {
      "label": "Run backend",
      "type": "shell",
      "command": "npm.cmd start",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "ALLOWED_ORIGINS": "http://127.0.0.1:5177,http://localhost:5177,http://127.0.0.1:5178,http://localhost:5178"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Run database tunnel",
      "type": "shell",
      "command": "ssh -N -o ServerAliveInterval=30 -o ExitOnForwardFailure=yes -L 15432:127.0.0.1:5433 -L 18082:127.0.0.1:8082 root@134.122.92.105",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Start School Bus local database",
      "type": "shell",
      "command": "docker compose --env-file .env.school.local -f docker-compose.school-local.yml up -d --wait",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Prepare School Bus local database",
      "type": "shell",
      "command": "npm.cmd run setup:school:local",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "dependsOrder": "sequence",
      "dependsOn": ["Start School Bus local database"],
      "problemMatcher": []
    },
    {
      "label": "Run School Bus API (local database only)",
      "type": "shell",
      "command": "npm.cmd run start:school:local",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "dependsOrder": "sequence",
      "dependsOn": ["Prepare School Bus local database"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Run Company portal",
      "type": "shell",
      "command": "npm.cmd run dev -- --host 0.0.0.0 --port 5177",
      "options": { "cwd": "${workspaceFolder}/company-admin/frontend" },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Run Super Admin portal",
      "type": "shell",
      "command": "npm.cmd run dev -- --host 127.0.0.1 --port 5178",
      "options": {
        "cwd": "${workspaceFolder}/super-admin/frontend",
        "env": {
          "VITE_PROXY_TARGET": "http://127.0.0.1:3001"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Start application servers",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Run backend",
        "Run School Bus API (local database only)",
        "Run Company portal",
        "Run Super Admin portal"
      ],
      "problemMatcher": []
    },
    {
      "label": "Start all local servers",
      "dependsOrder": "parallel",
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "dependsOn": [
        "Run database tunnel",
        "Run backend",
        "Run School Bus API (local database only)",
        "Run Company portal",
        "Run Super Admin portal"
      ],
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "focus": false,
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Test Super Admin",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/super-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Build Company portal",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/company-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Build Super Admin portal",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/super-admin/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Build both portals",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Company portal",
        "Build Super Admin portal"
      ],
      "problemMatcher": []
    }
  ]
}
